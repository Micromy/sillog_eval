# 테스트 환경 변수 (사내망에서 export 또는 source)
# 실제 값은 로컬에서 채우고 .env로 복사. 절대 커밋 금지.

# ── LLM ─────────────────────────────────────────────
PLATFORM=DTGPT
DTGPT_URL=
DTGPT_MODEL=
DTGPT_TOKEN=

# ── Jira ────────────────────────────────────────────
JIRA_URL=
JIRA_USERNAME=
JIRA_PASSWORD=
JIRA_VERIFY_SSL=false

# 이슈 지정: 둘 중 하나만 (TEST_JQL이 우선)
FILTER_ID=             # 저장된 Jira filter ID (5~10건 매칭)
TEST_JQL=              # 또는 JQL 직접 지정. 예: key in (PROJ-1, PROJ-2, PROJ-3)

# ── Oracle ──────────────────────────────────────────
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_PATH=           # thick client lib dir (필요 시)

# ── 저장 ───────────────────────────────────────────
SCORER_STORAGE_DIR=~/test_storage_eval

# ── 테스트 전용 ─────────────────────────────────────
TEST_EVAL_RULE_SET_ID= # 테스트용 eval_rule_set_id (운영용과 분리 권장)
SHUTDOWN_THRESHOLD=3   # 테스트에서는 빠른 트리거 (기본 운영은 10)
LLM_POOL_SIZE=2        # 소량 테스트라 풀 작게

# ── 동시성 (소량 테스트) ────────────────────────────
SCORER_MAX_WORKERS=2
SCORER_MAX_QUAL_WORKERS=2
SCORER_MAX_ROUNDS=2    # 테스트 빠르게
